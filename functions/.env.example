# Copy to functions/.env.music-and-poetry (DO NOT commit the real file)
# Use a domain verified with Resend. Do not use a Gmail/from-address you do not control.
NEWSLETTER_FROM="PrincessTG Music <news@YOUR-VERIFIED-DOMAIN.example>"
# Postal address required for commercial email. A valid PO box is acceptable.
NEWSLETTER_POSTAL_ADDRESS=YOUR VALID POSTAL ADDRESS
# Public website URL (no trailing slash)
PUBLIC_SITE_URL=https://princess8815.github.io/PrincessTGMusic
# Your deployed Firebase HTTPS function URL, default shown below.
UNSUBSCRIBE_ENDPOINT=https://us-central1-music-and-poetry.cloudfunctions.net/newsletterUnsubscribe
